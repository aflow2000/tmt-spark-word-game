{
  "name": "spark-word-tests",
  "private": true,
  "description": "Local test harness for Spark Word (not deployed). Run `npm install` inside tests/.",
  "scripts": {
    "db:reset": "bash reset_local_db.sh",
    "test:sql": "su postgres -c \"psql -v ON_ERROR_STOP=1 -d sparkword -f sql_tests.sql\"",
    "test:evaluate": "node evaluate.test.js",
    "harness": "node local-rpc-server.js",
    "test:ui": "node ui.integration.js",
    "test:preview": "node ui.preview.js"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.45.4",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "playwright": "^1.45.0"
  }
}
